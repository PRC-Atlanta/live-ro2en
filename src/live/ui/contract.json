{
  "version": 1,
  "about": "Contract between the orchestrator (src/live/app.py), the UI (src/live/ui/) and the Mac shell. Types: bool, str, num, int, null, unions 'a|b', {enum:[...]}, {list:T}, {map:T}, {object:{field:T}}; '@name' = types.name. An endpoint's 'errors' maps a refusal's HTTP status to the types its body can have. 'built' false = planned; the owner session adds it. Read docs/app_contract.md first.",

  "types": {
    "phase": {"enum": ["needs_setup", "loading", "ready", "starting", "listening", "captioning", "stopping", "stopped", "unloading", "error"]},
    "line": {"object": {"src": "str", "dst": "str", "lat": "num", "lang": {"enum": ["ro", "en"]}}},
    "problem_code": {"enum": ["no_sound", "device_lost", "mic_denied", "recognition_behind", "captions_behind",
                              "engine_stopped", "english_unavailable", "pp_unreachable", "pp_message_missing",
                              "disk_full", "models_missing"]},
    "not_built": {"object": {"error": {"enum": ["not_implemented"]}, "endpoint": "str", "owner": "str"}},
    "pp_status": {"object": {"connected": "bool", "since": "num|null", "last_ms": "num|null",
                             "error_code": {"enum": ["unreachable", "auth", "message_missing", null]}}},
    "pp_test": {"object": {"ok": "bool", "detail": "str", "messages": {"list": "str"}, "message_found": "bool", "pp": "@pp_status"}},
    "pp_test_caption": {"object": {"ok": "bool", "detail": "str", "pp": "@pp_status"}},
    "bad_request": {"object": {"error": {"enum": ["bad_request"]}, "detail": "str"}},
    "health": {"object": {"ok": "bool", "pid": "int", "phase": "@phase", "uptime_s": "num", "restarts": "int",
                          "engine": {"object": {"alive": "bool", "pid": "int|null", "hold": "bool", "listening": "bool"}}}},
    "readiness": {"object": {"phase": "@phase", "ready": "bool", "status": "str",
                             "progress": {"object": {"label": "str", "pct": "num"}, "nullable": true},
                             "problem": {"object": {"code": "@problem_code", "severity": {"enum": ["info", "warn", "error"]},
                                                    "action": {"object": {"id": "str", "label": "str"}}}, "nullable": true}}},
    "permissions": {"object": {"microphone": {"enum": ["granted", "denied", "restricted", "undetermined", "unknown"]}}},
    "preflight": {"object": {"checks": {"list": {"object": {"id": "str", "ok": "bool", "detail": "str", "code": "str?"}}},
                             "ok": "bool?", "t": "num?"}},
    "summary": {"object": {"elapsed_s": "num|null", "phrases": "int", "outcomes": {"map": "int"}, "failed": "int",
                           "latency_median": "num|null", "first_word_median": "num|null", "first_word_ok_pct": "num|null",
                           "pp_errors": "int", "corrections": "int", "warnings": "int", "engine_exits": "int",
                           "kind": {"enum": ["service", "rehearsal"]},
                           "rating": {"object": {"score": "int|null", "tags": {"list": "str"}, "note": "str"}}}},
    "setup": {"object": {"profiles": {"map": {"object": {"size_bytes": "int", "missing_bytes": "int", "ready": "bool", "downloadable": "bool"}}},
                                                      "models": {"list": {"object": {"id": "str", "profile": {"enum": ["fast", "quality"]}, "size_bytes": "int", "present": "bool", "published": "bool"}}},
                                                      "recommended_profile": {"enum": ["fast", "quality"]},
                                                      "disk": {"object": {"path": "str", "free_bytes": "int"}},
                                                      "hardware": {"object": {"ram_bytes": "int", "arch": "str", "chip": "str", "apple_silicon": "bool"}},
                                                      "checks": {"list": {"object": {"id": "str", "ok": "bool", "detail": "str"}}},
                                                      "needs_setup": "bool", "problem": {"enum": ["models_missing", null]},
                                                      "download": {"object": {"state": {"enum": ["idle", "running", "done", "cancelled", "error"]}, "running": "bool",
                                                                              "profile": "str|null", "done_bytes": "int", "total_bytes": "int", "pct": "num",
                                                                              "rate_bps": "num|null", "eta_s": "num|null", "item": "str|null", "file": "str|null",
                                                                              "error": "str|null", "error_code": "str|null"}}}},
    "setup_busy":    {"object": {"error": {"enum": ["live"]}, "msg": "str"}},
    "bad_profile":   {"object": {"error": {"enum": ["bad_profile"]}, "msg": "str"}},
    "device":        {"object": {"index": "int", "name": "str"}},
    "settings":      {"object": {"schema_version": "int", "values": {"map": "bool|num|str|null"}, "defaults": {"map": "bool|num|str|null"},
                                 "overrides": {"list": "str"},
                                 "fields": {"map": {"object": {"group": {"enum": ["basic", "propresenter", "advanced"]},
                                                               "type": {"enum": ["bool", "int", "num", "str", "enum", "device"]},
                                                               "apply": {"enum": ["now", "start", "launch"]}}}},
                                 "applies": {"map": {"enum": ["now", "start", "launch"]}}, "restart_required": "bool", "notes": {"list": "str"}}},
    "settings_rejected": {"object": {"error": {"enum": ["rejected"]}, "keys": {"list": "str"}, "detail": "str"}},
    "settings_invalid":  {"object": {"error": {"enum": ["invalid"]}, "detail": {"map": "str"}}},
    "keywords":      {"object": {"bundled": {"list": "str"}, "user": {"list": "str"}, "session": {"list": "str"}}},
    "spellings":     {"object": {"bundled": {"map": "str"}, "user": {"map": "str"}, "session": {"map": "str"}}},
    "terms":         {"object": {"lines": {"list": "str"}, "n": "int"}},
    "rated":         {"object": {"ok": "bool", "log": "str", "summary": "@summary"}},
    "exported":      {"object": {"ok": "bool", "format": "str", "path": "str", "log": "str"}},
    "no_session":    {"object": {"error": {"enum": ["no_session"]}, "detail": "str"}},
    "nothing_to_change": {"object": {"error": {"enum": ["nothing_to_change"]}, "detail": "str"}},
    "write_failed":  {"object": {"error": {"enum": ["write_failed"]}, "detail": "str"}}
  },

  "state": {
    "running":        {"type": "bool", "built": true},
    "status":         {"type": "str", "built": true},
    "mode":           {"type": {"enum": ["auto", "ro-en", "en-ro"]}, "built": true},
    "profile":        {"type": "str", "built": true},
    "profiles":       {"type": {"list": "str"}, "built": true},
    "lang":           {"type": {"enum": ["ro", "en"]}, "built": true},
    "partial":        {"type": "str", "built": true},
    "latency_last":   {"type": "num|null", "built": true},
    "latency_median": {"type": "num|null", "built": true},
    "lines":          {"type": {"list": "@line"}, "built": true},
    "screen":         {"type": "str", "built": true},
    "pp_error":       {"type": "str|null", "built": true},
    "warnings":       {"type": {"list": "str"}, "built": true},
    "counts":         {"type": {"map": "int"}, "built": true},
    "alerts":         {"type": {"list": "str"}, "built": true},
    "translator":     {"type": "str", "built": true},
    "stt":            {"type": "str", "built": true},

    "phase":          {"type": "@phase", "built": true, "owner": "S1"},
    "progress":       {"type": {"object": {"label": "str", "pct": "num"}}, "nullable": true, "built": true, "owner": "S1"},
    "audio":          {"type": {"object": {"device": "str|null", "rms_db": "num|null", "peak_db": "num|null", "speech": "bool",
                                           "last_voice_s": "num|null", "ok": "bool", "engine": "bool"}}, "built": true, "owner": "S1"},
    "pp":             {"type": {"object": {"connected": "bool", "since": "num|null", "last_ms": "num|null",
                                           "error_code": {"enum": ["unreachable", "auth", "message_missing", null]}}},
                       "built": true, "owner": "S2"},
    "pace":           {"type": {"object": {"state": {"enum": ["ok", "slow", "behind"]}, "behind_s": "num|null"}}, "built": true, "owner": "S4"},
    "backlog":        {"type": {"object": {"n": "int", "oldest_s": "num|null"}}, "built": true, "owner": "S4"},
    "paused":         {"type": "bool", "built": true, "owner": "S2"},
    "held":           {"type": "bool", "built": true, "owner": "S2"},
    "problem":        {"type": {"object": {"code": "@problem_code", "severity": {"enum": ["info", "warn", "error"]},
                                           "action": {"object": {"id": "str", "label": "str"}}}},
                       "nullable": true, "built": true, "owner": "S1"},
    "auto_actions":   {"type": {"list": {"object": {"t": "num", "msg": "str"}}}, "built": true, "owner": "S4"},
    "elapsed_s":      {"type": "num|null", "built": true, "owner": "S9"},
    "first_word_ok_pct": {"type": "num|null", "built": true, "owner": "S9"},
    "session_terms_n": {"type": "int", "built": true, "owner": "S3"},
    "corrections_n":  {"type": "int", "built": true, "owner": "S2"},
    "preflight":      {"type": "@preflight", "nullable": true, "built": true, "owner": "S9"}
  },

  "endpoints": [
    {"method": "GET",  "path": "/",                 "owner": "S1", "built": true, "response": "html"},
    {"method": "GET",  "path": "/legacy",           "owner": "S1", "built": true, "response": "html"},
    {"method": "GET",  "path": "/ui/",              "owner": "S5a", "built": true, "response": "html"},
    {"method": "GET",  "path": "/api/state",        "owner": "S1", "built": true, "response": "@state"},
    {"method": "WS",   "path": "/ws",               "owner": "S1", "built": true, "response": "@state"},
    {"method": "POST", "path": "/api/start",        "owner": "S1", "built": true, "request": {"device": "int|str|null"}, "response": "@state"},
    {"method": "POST", "path": "/api/stop",         "owner": "S1", "built": true, "response": "@state"},
    {"method": "POST", "path": "/api/preload",      "owner": "S1", "built": true, "request": {"device": "int|str|null?"}, "response": "@state",
     "about": "load the translator and a warm engine (hold) in the background; watch phase/progress. Does nothing while models are missing (phase needs_setup)"},
    {"method": "POST", "path": "/api/shutdown",     "owner": "S1", "built": true, "response": {"object": {"ok": "bool"}},
     "about": "stop the service and the engine, then the process exits (the shell's Quit)"},
    {"method": "POST", "path": "/api/unload",       "owner": "S1", "built": true, "response": "@state",
     "about": "free the memory: engine ended, translator dropped; phase -> unloading -> stopped"},
    {"method": "GET",  "path": "/api/health",       "owner": "S1", "built": true, "response": "@health"},
    {"method": "GET",  "path": "/api/readiness",    "owner": "S1", "built": true, "response": "@readiness"},
    {"method": "GET",  "path": "/api/permissions",  "owner": "S1", "built": true, "response": "@permissions"},

    {"method": "POST", "path": "/api/clear",        "owner": "S2", "built": true, "response": "@state"},
    {"method": "POST", "path": "/api/mode",         "owner": "S2", "built": true, "request": {"mode": "str"}, "response": "@state"},
    {"method": "POST", "path": "/api/profile",      "owner": "S2", "built": true, "request": {"profile": "str"}, "response": "@state"},
    {"method": "POST", "path": "/api/pause",        "owner": "S2", "built": true, "request": {"on": "bool"}, "response": "@state"},
    {"method": "POST", "path": "/api/blank",        "owner": "S2", "built": true, "response": "@state"},
    {"method": "POST", "path": "/api/hold",         "owner": "S2", "built": true, "request": {"on": "bool"}, "response": "@state"},
    {"method": "POST", "path": "/api/retract",      "owner": "S2", "built": true, "response": "@state",
     "errors": {"409": ["@nothing_to_change"]}},
    {"method": "POST", "path": "/api/correct",      "owner": "S2", "built": true, "request": {"text": "str"}, "response": "@state",
     "errors": {"400": ["@bad_request"], "409": ["@nothing_to_change"]}},
    {"method": "POST", "path": "/api/layout",       "owner": "S2", "built": true, "request": {"lines": "int?", "chars": "int?"}, "response": "@state"},
    {"method": "POST", "path": "/api/pp/test",      "owner": "S2", "built": true, "response": "@pp_test"},
    {"method": "POST", "path": "/api/pp/test_caption", "owner": "S2", "built": true, "response": "@pp_test_caption"},
    {"method": "POST", "path": "/api/reconnect",    "owner": "S2", "built": true, "response": "@state"},

    {"method": "GET",  "path": "/api/settings",     "owner": "S3", "built": true, "response": "@settings",
     "about": "values/defaults by dotted key; only keys in fields can be changed. apply: now = next phrase, start = next Start, launch = next app launch"},
    {"method": "PUT",  "path": "/api/settings",     "owner": "S3", "built": true, "request": {"values": {"map": "bool|num|str|null"}, "reset": "bool?"}, "response": "@settings",
     "errors": {"400": ["@settings_rejected", "@settings_invalid"]},
     "about": "400 {error: rejected, keys} for a key not in fields (nothing changes), 400 {error: invalid, detail: {key: reason}} for a bad value; restart_required = a changed start key while live"},
    {"method": "GET",  "path": "/api/keywords",     "owner": "S3", "built": true, "response": "@keywords"},
    {"method": "PUT",  "path": "/api/keywords",     "owner": "S3", "built": true, "request": {"user": {"list": "str"}}, "response": "@keywords", "errors": {"400": ["@settings_invalid"]},
     "about": "replaces the user's names & words; the bundled list stays"},
    {"method": "GET",  "path": "/api/spellings",    "owner": "S3", "built": true, "response": "@spellings"},
    {"method": "PUT",  "path": "/api/spellings",    "owner": "S3", "built": true, "request": {"user": {"map": "str"}}, "response": "@spellings", "errors": {"400": ["@settings_invalid"]},
     "about": "variant -> preferred; replaces the user's spellings"},
    {"method": "GET",  "path": "/api/terms",        "owner": "S3", "built": true, "response": "@terms"},
    {"method": "POST", "path": "/api/terms",        "owner": "S3", "built": true, "request": {"lines": {"list": "str"}, "save": "bool"}, "response": "@state", "errors": {"400": ["@settings_invalid"]},
     "about": "today's names: 'ro = en' or a bare name per line; replaces the previous list and applies live (glossary, spellings, Whistle keywords); save also keeps them for next time"},
    {"method": "POST", "path": "/api/import_config", "owner": "S3", "built": true, "request": {"text": "str?", "path": "str?"},
     "response": {"object": {"schema_version": "int", "values": {"map": "bool|num|str|null"}, "defaults": {"map": "bool|num|str|null"}, "overrides": {"list": "str"}, "fields": {"map": {"object": {"group": {"enum": ["basic", "propresenter", "advanced"]}, "type": {"enum": ["bool", "int", "num", "str", "enum", "device"]}, "apply": {"enum": ["now", "start", "launch"]}}}}, "applies": {"map": {"enum": ["now", "start", "launch"]}}, "restart_required": "bool", "notes": {"list": "str"}, "imported": {"list": "str"}, "spellings_added": "int", "ignored": {"list": "str"}}},
     "about": "the exposed settings and spellings from an old config.yaml (its text, or a .yaml path)"},
    {"method": "GET",  "path": "/api/devices",      "owner": "S6", "built": true, "response": {"list": "@device"}},
    {"method": "GET",  "path": "/api/setup",        "owner": "S6", "built": true, "response": "@setup"},
    {"method": "POST", "path": "/api/setup/download", "owner": "S6", "built": true, "request": {"profile": {"enum": ["fast", "quality"]}}, "response": "@setup",
     "errors": {"400": ["@bad_profile"], "409": ["@setup_busy"]}},
    {"method": "POST", "path": "/api/setup/cancel", "owner": "S6", "built": true, "response": "@setup"},

    {"method": "POST", "path": "/api/preflight",    "owner": "S9", "built": true, "response": "@preflight"},
    {"method": "POST", "path": "/api/rate",         "owner": "S9", "built": true, "request": {"score": "int", "tags": {"list": "str"}, "note": "str", "log": "str?"},
     "response": "@rated", "errors": {"400": ["@bad_request"], "404": ["@no_session"]}},
    {"method": "POST", "path": "/api/export",       "owner": "S9", "built": true, "request": {"format": {"enum": ["txt", "srt", "docx"]}, "log": "str?"},
     "response": "@exported", "errors": {"400": ["@bad_request"], "404": ["@no_session"], "507": ["@write_failed"]}},
    {"method": "POST", "path": "/api/diagnostics",  "owner": "S9", "built": true, "response": {"object": {"ok": "bool", "path": "str"}},
     "errors": {"507": ["@write_failed"]}},
    {"method": "POST", "path": "/api/rehearsal",    "owner": "S9", "built": true, "request": {"sample": "str?"}, "response": "@state"}
  ],

  "engine": {
    "events": {
      "ready":   {"built": true,  "fields": {"stt": "str", "multi": "bool", "source": "str", "hold": "bool?"}},
      "partial": {"built": true,  "fields": {"text": "str"}},
      "clause":  {"built": true,  "fields": {"id": "int", "ro": "str", "multi": "str", "en": "str", "source": "str?",
                                             "t_start": "num", "t_speech": "num", "t_end": "num", "t_emit": "num",
                                             "stt_s": "num", "audio_s": "num"}},
      "eof":     {"built": true,  "fields": {}},
      "warn":    {"built": true,  "fields": {"msg": "str"}},
      "error":   {"built": true,  "fields": {"where": {"enum": ["transcribe", "audio input", "english stream", "engine"]}, "msg": "str"}},
      "mode":    {"built": true,  "fields": {"mode": "str", "msg": "str"}},
      "backlog": {"built": true,  "fields": {"ok": "bool", "s": "num", "msg": "str"}},
      "audio":   {"built": true,  "fields": {"ok": "bool", "fault": {"enum": ["no_frames", "digital_silence", "mic_denied", null]}, "msg": "str"}},
      "loading": {"built": true, "owner": "S1", "fields": {"label": "str", "pct": "num"}},
      "level":   {"built": true, "owner": "S1", "fields": {"rms_db": "num", "peak_db": "num", "speech": "bool"},
                  "about": "~10 Hz (level_hz, 5-20) from the capture side; dBFS, -120 = nothing (zero samples)"},
      "listen":  {"built": true, "owner": "S1", "fields": {"on": "bool"},
                  "about": "answer to the listen command; listen off comes after the run's last clause"},
      "input":   {"built": true, "owner": "S1", "fields": {"device": "str|null"},
                  "about": "the input device opened (its name), on every open, reopen and device switch"}
    },
    "commands": {
      "mode":     {"built": true,  "fields": {"mode": {"enum": ["auto", "ro-en", "en-ro"]}}},
      "stop":     {"built": true,  "fields": {}},
      "listen":   {"built": true, "owner": "S1", "fields": {"on": "bool"},
                   "about": "--hold engines: on = transcribe (a --file starts playing), off = commit what is held, then back to the meter only"},
      "cfg":      {"built": true, "owner": "S1", "fields": {"cfg": {"map": "num|str|bool"}},
                   "about": "hot: vad_threshold min_pause_ms max_clause_s partial_every_s min/max_commit_s audio_watchdog_s digital_silence_s stt_backlog_s catchup_max_s context_s lookahead_words; others answer warn 'applied at the next start'"},
      "device":   {"built": true, "owner": "S1", "fields": {"device": "int|str|null"},
                   "about": "switch the mic without a restart (the orchestrator sends it when live.input_device changes while idle)"},
      "keywords": {"built": true, "owner": "S1", "fields": {"words": {"list": "str"}}, "about": "sent by S3: the user's + today's additions; the engine calls WhistleSTT.set_keywords(words) (bundled file + these, replacing earlier additions)"}
    }
  },

  "env": {
    "LIVE_HOME":              {"built": true, "about": "user data root; unset in dev = the repo"},
    "LIVE_LOG_DIR":           {"built": true, "about": "logs; default <LIVE_HOME>/logs"},
    "LIVE_CACHE_DIR":         {"built": true, "about": "caches; default <LIVE_HOME>/.cache"},
    "LIVE_ENGINE_PYTHON":     {"built": true, "about": "engine interpreter; default <repo>/<stt_venv>/bin/python"},
    "LIVE_ENGINE_PYTHONPATH": {"built": true, "about": "PYTHONPATH for the engine child (embedded runtime)"},
    "LIVE_ALLOW_NETWORK":     {"built": true, "about": "1 only for setup/download children"},
    "HF_HOME":                {"built": true, "about": "model cache; the app sets <LIVE_HOME>/hf"}
  },

  "flags": {
    "--config": {"built": true}, "--file": {"built": true}, "--autostart": {"built": true},
    "--exit-on-eof": {"built": true}, "--headless": {"built": true}, "--pp-port": {"built": true},
    "--mode": {"built": true}, "--profile": {"built": true}, "--port": {"built": true},
    "--settings": {"built": true, "owner": "S3"}, "--hold": {"built": true, "owner": "S1"}
  }
}
