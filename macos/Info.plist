	     (Sparkle generate_keys, account live-ro2en): an update not signed with it is refused. -->
	<key>SUFeedURL</key>
	<string>https://github.com/PRC-Atlanta/live-ro2en/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>9oNBbOQ+W6WUfkk/E5voUqAasClkLsqy7hfo40+4qxs=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
</dict>
