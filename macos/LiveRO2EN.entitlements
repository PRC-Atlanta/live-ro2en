<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- the microphone is opened by the engine child; TCC attributes it to this app -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- No JIT here: the shell runs none (WebKit's JIT is in Apple's own process). The bundled
	     Python that needs it is signed with packaging/runtime.entitlements. -->
</dict>
</plist>
